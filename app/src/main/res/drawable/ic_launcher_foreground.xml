<!-- Fractional insets preserve the same framing at every launcher size.
     The visible emblem fits the centered 66dp safe circle in the 108dp layer. -->
<inset xmlns:android="http://schemas.android.com/apk/res/android" android:inset="16%">
    <bitmap android:src="@drawable/ic_launcher_glass" android:gravity="fill"
        android:antialias="true" android:filter="true" android:mipMap="true" />
</inset>
